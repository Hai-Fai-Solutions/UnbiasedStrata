# Langfuse secrets (generate random values, never commit real ones)
NEXTAUTH_SECRET=change-me-to-a-long-random-string
# Public URL clients use to reach Langfuse (use http://<host-ip>:3000 for remote access)
NEXTAUTH_URL=http://localhost:3000
SALT=change-me-to-a-random-string

# LiteLLM access token for OpenAI-compatible clients
LITELLM_MASTER_KEY=sk-local-litellm

# Paste keys from your Langfuse project after first login
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
